#!/bin/sh
# dev/test-desktop — minimal Hyprland + Foot smoke test.
# GATED on dev/test-gpu reporting an ACCELERATED (non-llvmpipe) renderer
# (override: M1_ALLOW_LLVMPIPE=1 for harness validation on software GL).
# Uses seatd (no logind seat over SSH) + unprivileged user `desktop`.
# Env: M1_SSH_PORT (2222 headless QEMU, 2223 UTM GPU VM).
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$ROOT/artifacts/diagnostics/test-desktop-$(date +%Y%m%d-%H%M%S).log"
OVL="$ROOT/guest/overlays/desktop"

if "$ROOT/dev/shell" 'test -f /home/desktop/.local/state/omarchy/m2-core-seeded' 2>/dev/null; then
  echo 'Omarchy detected: use dev/test-omarchy; refusing to overwrite its desktop configuration.' >&2
  exit 1
fi

echo "== provisioning seatd + desktop user =="
"$ROOT/dev/shell" '
  set -eu
  pacman -Qq seatd >/dev/null 2>&1 || pacman -S --noconfirm seatd
  id desktop >/dev/null 2>&1 || useradd -m desktop
  usermod -aG video,seat,input desktop
  systemctl enable --now seatd
  install -d -o desktop -g desktop /home/desktop/.config/hypr /home/desktop/.config/foot /home/desktop/.local/bin
' 2>/dev/null
echo "== installing configs =="
"$ROOT/dev/shell" 'cat > /home/desktop/.config/hypr/hyprland.conf' < "$OVL/dotconfig/hypr/hyprland.conf" 2>/dev/null
"$ROOT/dev/shell" 'cat > /home/desktop/.config/foot/foot.ini' < "$OVL/dotconfig/foot/foot.ini" 2>/dev/null
"$ROOT/dev/shell" 'cat > /home/desktop/.local/bin/launch-hyprland.sh && chown -R desktop:desktop /home/desktop/.config /home/desktop/.local && chmod +x /home/desktop/.local/bin/launch-hyprland.sh' < "$OVL/dotlocal/bin/launch-hyprland.sh" 2>/dev/null

echo "== launching Hyprland =="
"$ROOT/dev/shell" '
  set -eu
  pkill -u desktop Hyprland 2>/dev/null || true
  sleep 1
  install -d -o desktop -g desktop -m 700 /run/user/1001
  nohup su -s /bin/sh desktop -c /home/desktop/.local/bin/launch-hyprland.sh >/dev/null 2>&1 &
  echo launched
' 2>/dev/null
sleep 20
"$ROOT/dev/shell" '
  echo "=== hyprland.log tail ==="
  tail -n 40 /home/desktop/hyprland.log 2>/dev/null || echo "(no log yet)"
  echo "=== renderer lines ==="
  grep -iE "renderer|opengl|egl|gbm|backend|drm|ERROR|failed|couldn" /home/desktop/hyprland.log 2>/dev/null | head -20
  echo "=== clients ==="
  SIG=$(ls /run/user/*/hypr/*/hyprland.lock 2>/dev/null | head -1)
  if [ -n "$SIG" ]; then
    HSIG=$(basename "$(dirname "$SIG")"); RDIR=$(dirname "$(dirname "$SIG")")
    su -s /bin/sh desktop -c "HYPRLAND_INSTANCE_SIGNATURE=$HSIG XDG_RUNTIME_DIR=$RDIR hyprctl clients 2>&1" | head -20
  else
    echo "(no hyprland socket yet)"
  fi
' 2>/dev/null | tee "$OUT"
