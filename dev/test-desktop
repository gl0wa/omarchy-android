#!/bin/sh
# dev/test-desktop — minimal Hyprland + Foot smoke test.
# GATED on dev/test-gpu reporting an ACCELERATED (non-llvmpipe) renderer.
# Uses seatd (no logind seat over SSH) + unprivileged user `desktop`.
# Env: M1_SSH_PORT (2222 headless QEMU, 2223 UTM GPU VM).
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$ROOT/artifacts/diagnostics/test-desktop-$(date +%Y%m%d-%H%M%S).log"
HCONF="$ROOT/guest/overlays/desktop/dotconfig/hypr/hyprland.conf"
FCONF="$ROOT/guest/overlays/desktop/dotconfig/foot/foot.ini"

echo "== provisioning seatd + desktop user =="
"$ROOT/dev/shell" '
  set -eu
  id desktop >/dev/null 2>&1 || {
    pacman -S --noconfirm seatd
    useradd -m desktop
    usermod -aG video,seat,input desktop
    systemctl enable --now seatd
  }
  install -d -o desktop -g desktop /home/desktop/.config/hypr /home/desktop/.config/foot
' 2>/dev/null
echo "== installing configs =="
"$ROOT/dev/shell" 'cat > /home/desktop/.config/hypr/hyprland.conf' < "$HCONF" 2>/dev/null
"$ROOT/dev/shell" 'cat > /home/desktop/.config/foot/foot.ini && chown -R desktop:desktop /home/desktop/.config' < "$FCONF" 2>/dev/null

echo "== launching Hyprland (see $OUT) =="
"$ROOT/dev/shell" '
  pkill -u desktop Hyprland 2>/dev/null || true
  sleep 1
  su - desktop -c "
    set -eu
    RUNDIR=/run/user/$(id -u)
    mkdir -p $RUNDIR
    chmod 700 $RUNDIR
    export XDG_RUNTIME_DIR=$RUNDIR
    export AQ_DRM_DEVICES=/dev/dri/card0
    nohup Hyprland > ~/hyprland.log 2>&1 &
    echo started
  "
' 2>/dev/null
sleep 20
"$ROOT/dev/shell" '
  echo "=== hyprland.log tail ==="
  tail -n 40 /home/desktop/hyprland.log 2>/dev/null || echo "(no log yet)"
  echo "=== renderer lines ==="
  grep -iE "renderer|opengl|egl|gbm|backend|drm|ERROR|failed|couldn" /home/desktop/hyprland.log 2>/dev/null | head -20
  echo "=== clients ==="
  SIG=$(ls /run/user/*/hypr/*/hyprland.lock 2>/dev/null | head -1)
  if [ -n "$SIG" ]; then
    export HYPRLAND_INSTANCE_SIGNATURE=$(basename $(dirname $SIG))
    export XDG_RUNTIME_DIR=$(dirname $(dirname $SIG))
    su - desktop -c "HYPRLAND_INSTANCE_SIGNATURE=$HYPRLAND_INSTANCE_SIGNATURE XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR hyprctl clients 2>&1 | head -20"
  else
    echo "(no hyprland socket yet)"
  fi
' 2>/dev/null | tee "$OUT"
